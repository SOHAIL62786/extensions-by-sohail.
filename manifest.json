{
    "manifest_version": 3,
    "name": "bajaj_finserv",
    "version": "4.0",
    "description": "Automates tasks on a webpage.",
    "permissions": [
        "identity","scripting", "storage", "unlimitedStorage", "activeTab", "notifications","downloads","management","offscreen","tabs"],
    "host_permissions": ["<all_urls>"],
     
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": "icon.png"
    },
    "commands": {
        "SQC": {
            "suggested_key": {
                "default": "Ctrl+Q"
            },
            "description": "SQC"
        },
        "fetchKycPoiDetails": {
            "suggested_key": {
                "default": "Alt+K"  
            },
            "description": "fetchKycPoiDetails"
        },
        "getCommand": {
            "suggested_key": {
                "default": "Alt+C"  
            },
            "description": "getCommand"
        },
        "fetchData": {
            "suggested_key": {
                "default": "Alt+R"
            },
            "description": "fetchData"
        }
    },

    "content_scripts": [
      {
        "matches": ["*://bflconsumer.my.site.com/*",
        "*://*.bajajfinserv.in/*",
        "*://bfin.in/*"],
        "js": ["jsQR.js","content.js"]
      },
      { 
        "matches": ["https://bflconsumer.my.site.com/dealerRevamp/s/report/*"],
        "js": ["xlsx.full.min.js"],
        "all_frames": true
      }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "message.html","message.css","jsQR.js",
                "https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js",
                "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
            ],
            "matches": ["<all_urls>"]
        }
    ]
  }
  