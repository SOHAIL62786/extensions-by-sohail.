{
    "manifest_version": 3,
    "name": "bajaj_finserv",
    "version": "4.0",
    "description": "Automates tasks on a webpage.",
    "permissions": [
        "storage", "unlimitedStorage", "activeTab", "downloads", "tabs"],
    "host_permissions": ["<all_urls>"],
     
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": "icon.png"
    },
    "commands": {
        "SQC": {
            "suggested_key": {
                "default": "Ctrl+Q"
            },
            "description": "SQC"
        },
        "getCommand": {
            "suggested_key": {
                "default": "Alt+C"  
            },
            "description": "getCommand"
        },
        "fetchData": {
            "suggested_key": {
                "default": "Alt+R"
            },
            "description": "fetchData"
        }
    },

    "content_scripts": [
      {
        "matches": ["*://bflconsumer.my.site.com/*",
        "*://*.bajajfinserv.in/*",
        "*://bfin.in/*"],
        "js": ["jsQR.js","content.js","qrLink.js","searchSave.js"]
      },
      { 
        "matches": ["https://bflconsumer.my.site.com/dealerRevamp/s/report/*",
        "https://bflconsumer.my.site.com/dealercommunityreinvent/s/report/*"],
        "js": ["xlsx.full.min.js"]
      }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "message.html","message.css","jsQR.js"
            ],
            "matches": ["<all_urls>"]
        }
    ]
  }
  